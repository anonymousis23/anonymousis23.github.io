# SQLite default, easiest for local collection.
DATABASE_URL=sqlite:///./responses.db

# Optional PostgreSQL example.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/phonos_study

# Comma-separated origins. Use * for quick testing.
ALLOWED_ORIGINS=*

# Optional token required for exports/admin endpoints.
# If set, call export endpoints with: ?token=YOUR_TOKEN
ADMIN_TOKEN=
