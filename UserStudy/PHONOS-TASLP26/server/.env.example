# Local development. Never use SQLite for a Vercel production deployment.
DATABASE_URL=sqlite:///./responses.db

# Production runtime: use Neon's pooled connection string.
# DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DBNAME?sslmode=require

# Schema migration: use Neon's direct (unpooled) connection string.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require

# Use * only for local testing. Production should permit the GitHub Pages origin.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Required to enable exports/admin endpoints.
ADMIN_TOKEN=replace-with-a-long-random-value

# SQLite can create/update tables at startup. Keep this disabled on Vercel.
AUTO_CREATE_SCHEMA=1

# Comma-separated allowlist. Both new studies use the same API deployment.
ALLOWED_STUDY_IDS=phonos_taslp26_accent_multidimensional,phonos_taslp26_voice_similarity_abx
